{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Keeper",
  "version": "0.21.0",
  "identifier": "com.umojaark.desk",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5191",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Keeper",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 620,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#0B1020"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: https:; media-src 'self' https: keeper-media: http://keeper-media.localhost; frame-src http://127.0.0.1:*; style-src 'self' 'unsafe-inline'; script-src 'self' 'wasm-unsafe-eval'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "category": "Productivity",
    "shortDescription": "Your personal assistant, remembered on your own DKG node",
    "longDescription": "Keeper is a personal assistant whose memory lives on your own OriginTrail DKG node. What it learns about you stays on your computer.",
    "publisher": "Tracverse L.L.C.",
    "copyright": "\u00a9 2026 Tracverse L.L.C. Umoja Ark.",
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-",
      "dmg": {
        "background": "dmg/background.png",
        "windowSize": {
          "width": 660,
          "height": 420
        },
        "appPosition": {
          "x": 180,
          "y": 230
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 230
        }
      },
      "entitlements": "Entitlements.plist"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFBNDg4RTA5QjBBOEQyQTIKUldTaTBxaXdDWTVJR3Nza0dwcEdEL0FDRWg2RzFRWTBDRitlRGVaQmN6SEhvTHhRTzFNYVUrUGoK",
      "endpoints": [
        "https://github.com/tracverse-development/keeper/releases/latest/download/latest.json"
      ]
    }
  }
}
