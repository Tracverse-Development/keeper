<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- The hardened runtime blocks the microphone without this; macOS then refuses silently and the
       app never appears in Privacy & Security > Microphone (FIX-0002). Applies to the app and its
       bundled voice helper. -->
  <key>com.apple.security.device.audio-input</key>
  <true/>
</dict>
</plist>
