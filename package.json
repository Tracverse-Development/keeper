{
  "name": "keeper",
  "private": true,
  "version": "0.10.0",
  "description": "Keeper: a personal assistant whose memory lives on your own OriginTrail DKG node.",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5191 --strictPort",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -p . --noEmit",
    "test": "node --test --experimental-strip-types \"src/**/*.test.ts\"",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "tauri": "tauri",
    "voice": "bash scripts/build-voice-helper.sh",
    "art": "python3 scripts/make-art.py",
    "app:build": "bash scripts/build-voice-helper.sh && tauri build",
    "check": "npm run typecheck && npm test && npm run test:rust"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.5",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.6",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.187.0",
    "@types/node": "24.10.1",
    "@vitejs/plugin-react": "6.0.3",
    "typescript": "6.0.3",
    "vite": "8.2.0"
  }
}
